# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.examples/
/.composables-examples/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# but DO commit the example so contributors know what to set
!.env.local.example
!.env.example

# npm auth token (registry _authToken) — never commit
.npmrc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
e2e/storage-state/*.json
playwright-report/
test-results/

# local tool config
.kiro/
.vscode/
# devbox dir
.devbox/
# Only the agent scratch space under docs/ is a tool artifact — `docs/` itself
# is real documentation that ships with the boilerplate, and ignoring the whole
# folder deleted it from the history of every shop scaffolded from it.
docs/superpowers/

# Auto-generated locale registry (regenerated by predev/prebuild)
locales/_registry.ts
locales/_locales.ts

# Claude harness transient lock
.claude/scheduled_tasks.lock

# PunchOut test fixtures (may contain a real shared secret)
SetupRequest_*.xml

# Generated by `npm run tracking:init --print-sql` for manual/DBA execution.
tracking-schema.sql
