# Strapi only needs to be reachable from the reverse proxy (nginx) on this host.
HOST=127.0.0.1
PORT=1337
# Secrets: generate fresh values per environment, never reuse the examples from Strapi's docs.
# One value: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_KEYS takes several of them, comma-separated. Strapi refuses to start while these are empty.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
CLIENT_URL=http://localhost:3000
# Must equal the frontend's STRAPI_PREVIEW_SECRET; Strapi preview stays off while unset.
# PREVIEW_SECRET=
