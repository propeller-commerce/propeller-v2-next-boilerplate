{
  "name": "propeller-next",
  "version": "1.15.0",
  "private": true,
  "scripts": {
    "locales:build": "node scripts/build-locales-registry.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-locales-registry.mjs",
    "predev": "node scripts/build-locales-registry.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "node -e \"const{rmSync}=require('fs');for(const d of ['.next','out'])rmSync(d,{recursive:true,force:true})\"",
    "sdk:sync": "npm update @propeller-commerce/propeller-sdk-v2 && npm install --install-links",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:tracking": "node --test --experimental-strip-types lib/tracking/*.test.ts",
    "tracking:init": "node --experimental-strip-types scripts/tracking-init.ts"
  },
  "dependencies": {
    "@contentful/rich-text-html-renderer": "^17.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@propeller-commerce/propeller-sdk-v2": "^0.16.0",
    "@propeller-commerce/propeller-v2-cms-react": "^0.1.5",
    "@propeller-commerce/propeller-v2-mollie": "^0.2.4",
    "@propeller-commerce/propeller-v2-msp": "^0.1.2",
    "@propeller-commerce/propeller-v2-punchout": "^0.1.0",
    "@propeller-commerce/propeller-v2-react-ui": "^0.19.0",
    "@propeller-commerce/propeller-v2-spl": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.560.0",
    "marked": "^17.0.5",
    "mysql2": "^3.23.3",
    "next": "16.3.1",
    "qs": "^6.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.6.0",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20",
    "@types/qs": "^6.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
